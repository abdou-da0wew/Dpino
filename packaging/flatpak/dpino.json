{
  "app-id": "io.abdou.dpino",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "dpino",
  "finish-args": [
    "--share=network",
    "--filesystem=home",
    "--filesystem=xdg-download"
  ],  
  "modules": [
    {
      "name": "dpino",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 target/release/dpino /app/bin/dpino",
        "install -Dm644 final/dpino/usr/share/applications/dpino.desktop /app/share/applications/dpino.desktop",
        "install -Dm644 final/dpino/usr/share/icons/hicolor/16x16/apps/dpino.png /app/share/icons/hicolor/16x16/apps/dpino.png",
        "install -Dm644 final/dpino/usr/share/icons/hicolor/22x22/apps/dpino.png /app/share/icons/hicolor/22x22/apps/dpino.png",
        "install -Dm644 final/dpino/usr/share/icons/hicolor/24x24/apps/dpino.png /app/share/icons/hicolor/24x24/apps/dpino.png",
        "install -Dm644 final/dpino/usr/share/icons/hicolor/32x32/apps/dpino.png /app/share/icons/hicolor/32x32/apps/dpino.png",
        "install -Dm644 final/dpino/usr/share/icons/hicolor/48x48/apps/dpino.png /app/share/icons/hicolor/48x48/apps/dpino.png",
        "install -Dm644 final/dpino/usr/share/icons/hicolor/64x64/apps/dpino.png /app/share/icons/hicolor/64x64/apps/dpino.png",
        "install -Dm644 final/dpino/usr/share/icons/hicolor/128x128/apps/dpino.png /app/share/icons/hicolor/128x128/apps/dpino.png",
        "install -Dm644 final/dpino/usr/share/icons/hicolor/256x256/apps/dpino.png /app/share/icons/hicolor/256x256/apps/dpino.png",
        "install -Dm644 final/dpino/usr/share/icons/hicolor/512x512/apps/dpino.png /app/share/icons/hicolor/512x512/apps/dpino.png"
      ],
      "sources": [
        {
          "type": "file",
          "url": "file:///target/release/dpino",
          "sha256": "SKIP"
        }
      ]
    }
  ]
}

